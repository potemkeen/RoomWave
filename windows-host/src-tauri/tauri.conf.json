{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RoomWave Host",
  "version": "0.1.2",
  "identifier": "com.roomwave.host",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "RoomWave", "width": 760, "height": 600, "minWidth": 420, "minHeight": 420 }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
