{
  "name": "roomwave-host",
  "private": true,
  "version": "0.1.5",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "tsc -p tsconfig.test.json && node --test tests/diagnosticsHealth.test.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:host": "tauri build --no-bundle",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.9",
    "typescript": "~5.7.3",
    "vite": "^6.4.0"
  }
}
